{
  "name": "wfes2-electron",
  "version": "3.0.0-beta.1",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && npm run bundle:bin && electron-builder",
    "dist:mac": "npm run build && npm run bundle:bin && electron-builder --mac",
    "dist:linux": "npm run build && npm run bundle:bin:linux && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "verify:numeric": "node --experimental-strip-types scripts/verify-numeric-helpers.ts",
    "verify:gui": "node scripts/verify-gui-params.mjs",
    "bundle:bin": "python3 scripts/bundle-dylibs.py --identity auto",
    "verify:bin": "python3 scripts/bundle-dylibs.py --verify-only --identity auto",
    "verify:latex": "node --experimental-strip-types scripts/verify-latex-conversion.ts",
    "bundle:bin:adhoc": "python3 scripts/bundle-dylibs.py",
    "notarize": "scripts/notarize.sh",
    "dist:mac:release": "WFES3_NOTARIZE=1 npm run dist:mac && npm run notarize",
    "verify:diagrams": "node --experimental-strip-types scripts/verify-diagrams.ts",
    "verify:previews": "node scripts/verify-previews.mjs",
    "verify:labels": "node scripts/verify-labels.mjs",
    "verify:charts": "node scripts/verify-charts.mjs",
    "verify:thinning": "node --experimental-strip-types scripts/verify-thinning.ts",
    "verify:initial": "node scripts/verify-initial.mjs",
    "verify:about": "node scripts/verify-about.mjs",
    "verify:crosslinks": "node scripts/verify-crosslinks.mjs",
    "verify:projection": "node scripts/verify-projection.mjs",
    "postinstall": "node -e \"if(process.platform==='darwin'){require('child_process').execSync('bash scripts/brand-dev-electron.sh',{stdio:'inherit'})}\"",
    "bundle:bin:linux": "bash scripts/bundle-bin-linux.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/node": "^22.15.24",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.4.21",
    "electron": "^36.3.2",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "png-to-ico": "^2.1.8",
    "png2icns": "^0.0.1",
    "postcss": "^8.5.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@arco-design/web-react": "^2.66.1",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@mantine/core": "^8.0.2",
    "@mantine/hooks": "^8.0.2",
    "@tabler/icons-react": "^3.34.0",
    "katex": "^0.16.22",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^8.0.7",
    "recharts": "^2.15.3",
    "rehype-katex": "^6.0.3",
    "remark-math": "^5.1.1"
  }
}
