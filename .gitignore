# ---------------------------------------------------------------------------
# WFES3 (library + CLI + Electron GUI) additions
# ---------------------------------------------------------------------------

# CMake / make build trees. The CLI is built in wfes-cli/build, which the
# Electron app resolves at runtime in dev mode -- it must exist locally but
# must never be committed.
/build-cmd/
/wfes-cli/build*/
/wfes-cli/*/build/
/wfes-lib/build/
/wfes-ui/build/

# Node / Electron
node_modules/
/wfes-ui/wfes2-electron/out/
/wfes-ui/wfes2-electron/dist/
# Generated by scripts/bundle-dylibs.py: the CLI binaries plus their vendored,
# relocated dylibs. Regenerate with `npm run bundle:bin`; never commit.
/wfes-ui/wfes2-electron/resources/
npm-debug.log*
yarn-error.log*
.eslintcache
.vite/

# Prebuilt Qt-era binaries (313 MB; preserved in the public Qt repository)
/binaries/

# Vendored dependency archive. Superseded by Homebrew/submodule dependencies;
# excluded from history deliberately -- see README for how to obtain deps.
dependencies.7z

# Stray ParU/UMFPACK experiment executables. The .cpp sources and the
# CMakeLists/scripts are kept (see the ParU integration notes (internal dev notes)); only the
# compiled artifacts are ignored.
/wfes-cli/test_paru*
/wfes-cli/test_umfpack_parallel
/wfes-cli/wfes_single_clean
!/wfes-cli/test_paru*.cpp
!/wfes-cli/test_paru*.sh
!/wfes-cli/test_paru_CMakeLists.txt
!/wfes-cli/test_umfpack_parallel.cpp

# Solver scratch output
/wfes-cli/stdout
/wfes-cli/debug_matrix.mtx
*.bak
*.backup

# Wright-Fisher out-of-core scratch files
ooc_temp.*
# Python bytecode
__pycache__/
*.pyc

# Claude Code session config -- developer-local, never shipped
.claude/
